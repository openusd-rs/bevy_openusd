#usda 1.0
(
    defaultPrim = "Showcase"
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 10
    timeCodesPerSecond = 24
)

def Xform "Showcase" {
    def Cube "Plinth" {
        double size = 1
        double3 xformOp:scale = (12, 0.2, 7)
        double3 xformOp:translate = (0, -0.1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </Showcase/Materials/Slate>
    }
    def Cube "ChangingCube" {
        double size.timeSamples = { 0: 1, 10: 2 }
        double3 xformOp:translate.timeSamples = { 0: (-3,0.5,0), 10: (-3,1,0) }
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </Showcase/Materials/Animated>
    }
    def PointInstancer "GrowingPrototypes" {
        point3f[] positions = [(-0.5,0,0), (1.5,0,0), (3.5,0,0)]
        int[] protoIndices = [0,0,0]
        int64[] ids = [10,20,30]
        rel prototypes = [</Showcase/Prototypes/Tetrahedron>]
    }
    def Scope "Prototypes" {
        def Mesh "Tetrahedron" {
            uniform token purpose = "guide"
            uniform token subdivisionScheme = "none"
            point3f[] points.timeSamples = {
                0: [(-0.5,0,-0.5), (0.5,0,-0.5), (0,0,0.5), (0,1,0)],
                10: [(-0.7,0,-0.7), (0.7,0,-0.7), (0,0,0.7), (0,2.5,0)]
            }
            int[] faceVertexCounts = [3,3,3,3]
            int[] faceVertexIndices = [0,3,1,1,3,2,2,3,0,0,1,2]
            rel material:binding = </Showcase/Materials/Animated>
        }
    }
    def Scope "Materials" {
        def Material "Slate" {
            token outputs:surface.connect = </Showcase/Materials/Slate/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.13,0.16,0.2)
                float inputs:roughness = 0.8
                token outputs:surface
            }
        }
        def Material "Animated" {
            token outputs:surface.connect = </Showcase/Materials/Animated/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.timeSamples = { 0: (0.8,0.12,0.03), 10: (0.03,0.3,0.8) }
                float inputs:roughness.timeSamples = { 0: 0.7, 10: 0.25 }
                float inputs:metallic = 0.15
                token outputs:surface
            }
        }
    }
}
