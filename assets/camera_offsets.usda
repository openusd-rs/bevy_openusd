#usda 1.0
(
    defaultPrim = "Scene"
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 10
)
def Xform "Scene" {
    def Camera "Camera" {
        float focalLength = 50
        float horizontalAperture = 40
        float verticalAperture = 20
        float horizontalApertureOffset.timeSamples = {0: 0, 10: 10}
        float verticalApertureOffset.timeSamples = {0: 0, 10: 3}
        double3 xformOp:translate = (0,0,6)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Cube "Cube" {
        double size = 0.8
        color3f[] primvars:displayColor = [(0.05,0.5,0.8)]
    }
}
