+impl AttributeValueSource {
+    /// Heap storage of accounted sources, including sample-map capacity.
+    pub(crate) fn heap_bytes(&self) -> Option<usize> {
+        match self {
+            Self::Static(None) | Self::PerTime => Some(0),
+            Self::Static(Some(value)) => value.heap_bytes(),
+            Self::TimeSamples { samples, site, .. } => {
+                let bytes = samples
+                    .capacity()
+                    .checked_mul(size_of::<(f64, Value)>())?
+                    .checked_add(site.heap_bytes()?)?;
+                samples
+                    .iter()
+                    .try_fold(bytes, |bytes, (_, value)| bytes.checked_add(value.heap_bytes()?))
+            }
+        }
+    }
+}
