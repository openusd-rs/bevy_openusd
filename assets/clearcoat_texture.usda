#usda 1.0
(
    upAxis = "Y"
    subLayers = [@dome_reference_exr.usda@]
)
over "Env" {
    float inputs:intensity.timeSamples = { 0: 10000, 10: 10000 }
    float xformOp:rotateY.timeSamples = { 0: 0, 10: 0 }
}
over "Matte" {
    over "Shader" {
        color3f inputs:diffuseColor = (0.25, 0.04, 0.01)
        float inputs:clearcoat.connect = </Matte/Coat.outputs:b>
        float inputs:clearcoatRoughness.connect = </Matte/Coat.outputs:g>
    }
    def Shader "Coat" {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @clearcoat_channels.png@
        token inputs:sourceColorSpace = "raw"
        float4 inputs:scale.timeSamples = { 0: (1,1,1,1), 10: (1,1,0,1) }
        float outputs:b
        float outputs:g
    }
}
