#usda 1.0
(
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 30
)

def Xform "First" {
    double3 xformOp:translate = (-4, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    def Cube "Geometry" {
        double size.timeSamples = {0: 1, 10: 3}
        color3f[] primvars:displayColor = [(0.12, 0.55, 0.85)]
    }
}

