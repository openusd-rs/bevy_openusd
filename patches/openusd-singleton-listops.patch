     use super::*;
     use crate::sdf::{Data, path};
 
+    #[test]
+    fn singleton_metadata_listops_keep_array_syntax() {
+        for operation in ["", "prepend ", "append ", "delete ", "add ", "reorder "] {
+            let source = format!(
+                "#usda 1.0\ndef Xform \"Root\" (\n    {operation}apiSchemas = [\"MaterialBindingAPI\"]\n) {{}}\n"
+            );
+            let data = crate::usda::parse(&source).expect("parses");
+            let text = TextWriter::write_to_string(&data as &dyn AbstractData).expect("writes");
+            assert!(
+                text.contains(&format!("{operation}apiSchemas = [\"MaterialBindingAPI\"]")),
+                "{text}"
+            );
+            let reparsed = crate::usda::parse(&text).expect("re-parses");
+            let root = path("/Root").unwrap();
+            assert_eq!(data.spec(&root).unwrap().fields, reparsed.spec(&root).unwrap().fields);
+        }
+    }
+
