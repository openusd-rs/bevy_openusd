#usda 1.0
(
    upAxis = "Y"
)
def Cube "Model" (
    prepend variantSets = ["look"]
    variants = { string look = "red" }
) {
    variantSet "look" = {
        "red" {
            double size = 1
            color3f[] primvars:displayColor = [(0.8, 0.05, 0.02)]
        }
        "blue" {
            double size = 2
            color3f[] primvars:displayColor = [(0.02, 0.1, 0.8)]
        }
    }
}
