#usda 1.0
(
    subLayers = [@skel_influences.usda@]
)

over "Test"
{
    over "Bar"
    {
        int[] primvars:skel:jointIndices = [0,1] (
            elementSize = 2
            interpolation = "constant"
        )
        float[] primvars:skel:jointWeights (
            elementSize = 2
            interpolation = "constant"
        )
        float[] primvars:skel:jointWeights.timeSamples = {
            0: [1,0],
            10: [0,1]
        }
    }
}
