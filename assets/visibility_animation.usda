#usda 1.0
(
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 20
    timeCodesPerSecond = 1
)
def Cube "Animated"
{
    double size = 1
    double3 xformOp:translate = (-1,0.5,0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    token visibility = "inherited"
    token visibility.timeSamples = {0: "inherited", 10: "invisible", 20: "inherited"}
}
def Cube "Visible"
{
    double size = 1
    double3 xformOp:translate = (1,0.5,0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
