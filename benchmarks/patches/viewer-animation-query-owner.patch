+        let path = sdf::path("/Anim").unwrap();
+        let builtin = SchemaRegistry::builtin();
+        let mut world = World::new();
+        let first = builtin.with_materials(&mut world, &live, |_| {
+            anim_query(&live.stage, &path).unwrap().unwrap()
+        });
+        let owner = Rc::downgrade(live.animation_queries.borrow().as_ref().unwrap());
+        world.insert_resource(AnimationQueryLimits {
+            max_queries: 0,
+            ..Default::default()
+        });
+        let uncached = builtin.with_materials(&mut world, &live, |_| {
+            anim_query(&live.stage, &path).unwrap().unwrap()
+        });
+        assert!(owner.upgrade().is_none());
+        assert!(!Rc::ptr_eq(&first, &uncached));
+        world.remove_resource::<AnimationQueryLimits>();
+        builtin.with_materials(&mut world, &live, |world| {
+            let outer = anim_query(&live.stage, &path).unwrap().unwrap();
+            {
+                let _nested = SkelSampleScope::begin(&live.stage);
+                let inner = anim_query(&live.stage, &path).unwrap().unwrap();
+                assert!(!Rc::ptr_eq(&outer, &inner));
+            }
+            SchemaRegistry::new().with_materials(world, &live, |_| {
+                let a = anim_query(&live.stage, &path).unwrap().unwrap();
+                let b = anim_query(&live.stage, &path).unwrap().unwrap();
+                assert!(!Rc::ptr_eq(&a, &b));
+                assert!(!Rc::ptr_eq(&outer, &a));
+            });
+            assert!(Rc::ptr_eq(
+                &outer,
+                &anim_query(&live.stage, &path).unwrap().unwrap()
+            ));
+        });
+        SchemaRegistry::new().with_materials(&mut world, &live, |_| {
+            let a = anim_query(&live.stage, &path).unwrap().unwrap();
+            let b = anim_query(&live.stage, &path).unwrap().unwrap();
+            assert!(!Rc::ptr_eq(&a, &b));
+        });
+        assert!(live.animation_queries.borrow().is_none());
+    }
+}
