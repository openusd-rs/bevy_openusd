+    fn source_sample_field(field: Cow<'_, Value>) -> Result<AttributeValueSource> {
+        let (graph, mut cache) = in_memory_stack("#usda 1.0\ndef Xform \"P\" {}\n");
+        let view = graph.read_view();
+        let prim = sdf::path("/P")?;
