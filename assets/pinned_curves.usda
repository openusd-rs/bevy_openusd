#usda 1.0
(
    upAxis = "Y"
)

def BasisCurves "PinnedBspline" {
    uniform token type = "cubic"
    uniform token basis = "bspline"
    uniform token wrap = "pinned"
    int[] curveVertexCounts = [4]
    point3f[] points = [(-1,0,0), (-0.5,1,0), (0.5,1,0), (1,0,0)]
    double3 xformOp:translate = (-1.5,1,0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def BasisCurves "ExplicitBspline" {
    uniform token type = "cubic"
    uniform token basis = "bspline"
    uniform token wrap = "nonperiodic"
    int[] curveVertexCounts = [6]
    point3f[] points = [(-1.5,-1,0), (-1,0,0), (-0.5,1,0), (0.5,1,0), (1,0,0), (1.5,-1,0)]
    double3 xformOp:translate = (1.5,1,0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

