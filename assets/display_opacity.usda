#usda 1.0
(
    defaultPrim = "Scene"
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 10
)
def Xform "Scene" {
    def Cube "Cube" {
        double size = 0.8
        double3 xformOp:translate = (-1,0,0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.8,0.2,0.1)]
        float[] primvars:displayOpacity.timeSamples = {0: [0.2], 10: [1]}
    }
    def Mesh "Mesh" {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(0.5,-0.5,0), (1.5,-0.5,0), (1.5,0.5,0), (0.5,0.5,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        color3f[] primvars:displayColor = [(0.8,0.2,0.1)]
        float[] primvars:displayOpacity.timeSamples = {0: [0.2], 10: [1]}
    }
    def Plane "Backdrop" {
        double width = 5
        double length = 3
        uniform token axis = "Z"
        double3 xformOp:translate = (0,0.75,-1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        color3f[] primvars:displayColor = [(0.05,0.3,0.6)]
    }
    def PointInstancer "PI" {
        rel prototypes = </Scene/Cube>
        int[] protoIndices = [0]
        point3f[] positions = [(0,1.5,0)]
    }
}
