#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 10
)
def Xform "Root" {
    normal3f[] primvars:normals.timeSamples = {
        0: [(0,0,1)],
        10: [(1,0,0)]
    }
    def Mesh "M" {
        point3f[] points = [(-1,0,0),(1,0,0),(1,2,0),(-1,2,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        uniform token subdivisionScheme = "none"
        color3f[] primvars:displayColor = [(0.1,0.6,0.7)] (
            interpolation = "constant"
        )
    }
}
