+    /// Bytes in the query record, ordering capacities and attribute handles.
+    /// Shared paths and orderings are charged in full. Source-owned heap
+    /// storage, stage storage, allocator and reference-count headers are excluded.
+    /// Returns `None` on arithmetic overflow.
+    pub fn metadata_bytes(&self) -> Option<usize> {
+        let mut bytes = size_of::<Self>()
+            .checked_add(self.anim.prim().path().heap_bytes()?)?
+            .checked_add(self.joints.capacity().checked_mul(size_of::<String>())?)?
+            .checked_add(self.blend_shapes.len().checked_mul(size_of::<String>())?)?;
+        for name in self.joints.iter().chain(self.blend_shapes.iter()) {
+            bytes = bytes.checked_add(name.capacity())?;
+        }
+        if let Some(queries) = self.queries.as_deref() {
+            bytes = bytes.checked_add(size_of::<[AttributeQuery; 4]>())?;
+            for query in queries {
+                bytes = bytes.checked_add(query.attribute().path().heap_bytes()?)?;
+            }
+        }
+        Some(bytes)
+    }
+
     /// Joint ordering as authored on the Animation. Does not
