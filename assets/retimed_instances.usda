#usda 1.0
(
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 30
)

class Xform "Model" {
    def Cube "Geometry" {
        double size.timeSamples = {0: 1, 10: 3}
        color3f[] primvars:displayColor = [(0.12, 0.55, 0.85)]
    }
}

def Xform "First" (
    instanceable = true
    prepend references = </Model>
) {
    double3 xformOp:translate = (-4, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "Second" (
    instanceable = true
    prepend references = </Model>
) {
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def Xform "Retimed" (
    instanceable = true
    prepend references = </Model> (offset = 10; scale = 2)
) {
    double3 xformOp:translate = (4, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
