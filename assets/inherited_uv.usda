#usda 1.0
(
    defaultPrim = "Root"
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 10
)
def Xform "Root" {
    texCoord2f[] primvars:st = [(0.25,0.25), (0.75,0.75)] (interpolation = "constant")
    int[] primvars:st:indices.timeSamples = {0: [0], 10: [1]}
    def Mesh "Inherited" {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(-2,-0.5,0), (-1,-0.5,0), (-1,0.5,0), (-2,0.5,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        rel material:binding = </Material>
    }
    def Mesh "Explicit" {
        uniform token subdivisionScheme = "none"
        point3f[] points = [(1,-0.5,0), (2,-0.5,0), (2,0.5,0), (1,0.5,0)]
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0,1,2,3]
        texCoord2f[] primvars:st.timeSamples = {
            0: [(0.25,0.25), (0.25,0.25), (0.25,0.25), (0.25,0.25)],
            10: [(0.75,0.75), (0.75,0.75), (0.75,0.75), (0.75,0.75)]
        }
        rel material:binding = </Material>
    }
}
def PointInstancer "PI" {
    rel prototypes = </Root/Inherited>
    int[] protoIndices = [0]
    point3f[] positions = [(1.5,0,0)]
}
def Material "Material" {
    token outputs:surface.connect = </Material/Surface.outputs:surface>
    def Shader "Surface" {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Material/Texture.outputs:rgb>
        float inputs:roughness = 1
        token outputs:surface
    }
    def Shader "Texture" {
        uniform token info:id = "UsdUVTexture"
        asset inputs:file = @quadrants.png@
        token inputs:sourceColorSpace = "sRGB"
        float3 outputs:rgb
    }
}
