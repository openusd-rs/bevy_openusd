#usda 1.0
(
    defaultPrim = "Surface"
    upAxis = "Y"
    metersPerUnit = 1
)
def Mesh "Surface" {
    uniform token subdivisionScheme = "catmullClark"
    uniform token interpolateBoundary = "edgeAndCorner"
    point3f[] points = [
        (-3,0,-3),(-1,0,-3),(1,0,-3),(3,0,-3),
        (-3,0,-1),(-1,0,-1),(1,0,-1),(3,0,-1),
        (-3,0,1),(-1,0,1),(1,0,1),(3,0,1),
        (-3,0,3),(-1,0,3),(1,0,3),(3,0,3)
    ]
    int[] faceVertexCounts = [4,4,4,4,4,4,4,4,4]
    int[] faceVertexIndices = [
        0,4,5,1, 1,5,6,2, 2,6,7,3,
        4,8,9,5, 5,9,10,6, 6,10,11,7,
        8,12,13,9, 9,13,14,10, 10,14,15,11
    ]
    int[] holeIndices = [4]
    color3f[] primvars:displayColor = [(0.05,0.45,0.8)] ( interpolation = "constant" )
}
