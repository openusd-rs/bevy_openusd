+        assert_eq!(budget.retained_entries(), 0);
+        compare(&second, &direct)?;
+        assert_eq!(budget.retained_entries(), 4);
+        assert_eq!(budget.retained_bytes(), bytes);
+        drop(second);
+        assert_eq!(budget.retained_bytes(), 0);
+        Ok(())
+    }
