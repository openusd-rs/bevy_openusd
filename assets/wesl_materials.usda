#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

def Mesh "Flat" {
    uniform token subdivisionScheme = "none"
    uniform bool doubleSided = true
    point3f[] points = [(-3,0,0), (-1.5,0,0), (-1.5,1.5,0), (-3,1.5,0.4)]
    int[] faceVertexCounts = [3,3]
    int[] faceVertexIndices = [0,1,2,0,2,3]
    color3f[] primvars:displayColor = [(0.8,0.25,0.1)]
}

def Sphere "Sheen" (prepend apiSchemas = ["MaterialBindingAPI"]) {
    double radius = 0.7
    double3 xformOp:translate = (-0.5,0.8,0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </Looks/Cloth>
}

def Cube "Medium" (prepend apiSchemas = ["MaterialBindingAPI"]) {
    double size = 1
    double3 xformOp:translate = (1.1,0.65,0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </Looks/Water>
}

def BasisCurves "RoundStrands" {
    uniform token type = "linear"
    int[] curveVertexCounts = [3,3]
    point3f[] points = [(2,0,0), (2.2,0.8,0), (2.5,1.5,0), (2.4,0,0), (2.6,0.8,0), (2.9,1.5,0)]
    float[] widths = [0.12] (interpolation = "constant")
    color3f[] primvars:displayColor = [(0.1,0.8,0.2)]
}

def BasisCurves "OrientedStrands" {
    uniform token type = "linear"
    int[] curveVertexCounts = [3]
    point3f[] points = [(2,0,0.3), (2.3,0.8,0.3), (2.6,1.5,0.3)]
    float[] widths = [0.15] (interpolation = "constant")
    normal3f[] normals = [(0,0,1)] (interpolation = "constant")
    color3f[] primvars:displayColor = [(0.7,0.8,0.1)]
}

def Cube "Floor" {
    double size = 1
    double3 xformOp:translate = (0,-0.15,0)
    double3 xformOp:scale = (8,0.2,4)
    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    color3f[] primvars:displayColor = [(0.35,0.4,0.5)]
}

def PointInstancer "Instances" {
    rel prototypes = [</Prototype>]
    int[] protoIndices = [0,0,0,0]
    point3f[] positions = [(-2.5,0.3,-1), (-1,0.3,-1), (0.5,0.3,-1), (2,0.3,-1)]
}

def Sphere "Prototype" (prepend apiSchemas = ["MaterialBindingAPI"]) {
    double radius = 0.25
    rel material:binding = </Looks/Cloth>
}

def DistantLight "Sun" {
    float inputs:intensity = 1.2
    double3 xformOp:rotateXYZ = (-35,-25,0)
    uniform token[] xformOpOrder = ["xformOp:rotateXYZ"]
}

def Scope "Looks" {
    def Material "Cloth" {
        token outputs:ri:surface.connect = </Looks/Cloth/Shader.outputs:bxdf_out>
        def Shader "Shader" {
            uniform token info:id = "PxrDisneyBsdf"
            color3f inputs:baseColor = (0.3,0.15,0.7)
            float inputs:roughness = 0.65
            float inputs:sheen = 0.8
            float inputs:sheenTint = 0.7
            token outputs:bxdf_out
        }
    }
    def Material "Water" {
        token outputs:ri:surface.connect = </Looks/Water/Shader.outputs:bxdf_out>
        def Shader "Shader" {
            uniform token info:id = "PxrSurface"
            color3f inputs:diffuseColor = (0.15,0.5,0.35)
            float inputs:refractionGain = 1
            color3f inputs:refractionColor = (0.9,0.95,1)
            float inputs:diffuseTransmitGain = 0.4
            color3f inputs:diffuseTransmitColor = (0.1,0.8,0.4)
            float inputs:glassIor = 1.33
            float inputs:glassRoughness = 0.1
            token outputs:bxdf_out
        }
    }
}
