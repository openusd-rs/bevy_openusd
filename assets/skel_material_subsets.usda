#usda 1.0
(
    subLayers = [@skel_test_simple.usda@]
)

over "Test"
{
    over "Bar"
    {
        def GeomSubset "Orange"
        {
            uniform token familyName = "materialBind"
            uniform token elementType = "face"
            int[] indices = [0,2,4,6,8,10,12]
            rel material:binding = </Orange>
        }
        def GeomSubset "Blue"
        {
            uniform token familyName = "materialBind"
            uniform token elementType = "face"
            int[] indices = [1,3,5,7,9,11,13]
            rel material:binding = </Blue>
        }
    }
}
def Material "Orange"
{
    token outputs:surface.connect = </Orange/Surface.outputs:surface>
    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.8,0.2,0.02)
        token outputs:surface
    }
}
def Material "Blue"
{
    token outputs:surface.connect = </Blue/Surface.outputs:surface>
    def Shader "Surface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor = (0.02,0.2,0.8)
        token outputs:surface
    }
}
