+        assert_eq!(calls, [0]);
+        calls.clear();
+        let error = components_at(|index| {
+            calls.push(index);
+            if index == 0 {
+                Ok(Some(Value::Vec3fVec(vec![gf::vec3f(0.0, 0.0, 0.0)])))
+            } else {
