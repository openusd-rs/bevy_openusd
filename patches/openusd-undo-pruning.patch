+        stage.prim("/World")?.set_type_name("Scope")?;
+        assert_eq!(stage.discard_oldest(usize::MAX), 1);
+        assert!(!stage.can_undo());
+        assert_eq!(stage.prim("/World")?.type_name()?.as_deref(), Some("Scope"));
+        stage.prim("/World")?.set_type_name("Xform")?;
+        assert!(stage.undo()?);
+        assert_eq!(stage.prim("/World")?.type_name()?.as_deref(), Some("Scope"));
