+    #[test]
+    fn budgeted_reentrant_edit() -> Result<()> {
+        let (stage, anim) = fixture()?;
+        let budget = QueryCacheBudget::new(16_384, 4);
+        let query = Rc::new(AnimQuery::with_budget(anim.clone(), &budget)?);
+        query.joint_transform_components(TimeCode::new(5.0))?.unwrap();
+        let weak = Rc::downgrade(&query);
+        let observed = Rc::new(Cell::new(None));
+        let result = observed.clone();
+        let _token = stage.add_sink(move |_: &Stage, _: &CommittedChange<'_>| {
+            let query = weak.upgrade().unwrap();
+            let components = query.joint_transform_components(TimeCode::new(5.0)).unwrap().unwrap();
