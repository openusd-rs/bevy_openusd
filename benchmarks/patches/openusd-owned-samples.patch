+        for owned in [false, true] {
+            let mut numbers = Vec::with_capacity(32);
+            numbers.extend([1.0_f32, 2.0]);
+            let values_pointer = numbers.as_ptr();
+            let values_capacity = numbers.capacity();
+            let mut samples = Vec::with_capacity(16);
+            samples.push((0.0, Value::FloatVec(numbers)));
+            let pointer = samples.as_ptr();
+            let capacity = samples.capacity();
+            let mut field = Some(Value::TimeSamples(samples));
+            let source = source_sample_field(if owned {
+                Cow::Owned(field.take().unwrap())
+            } else {
+                Cow::Borrowed(field.as_ref().unwrap())
+            })?;
+            let AttributeValueSource::TimeSamples { samples, .. } = source else {
+                panic!("expected source map")
+            };
+            let numbers = samples[0].1.try_as_float_vec_ref().unwrap();
+            assert_eq!(samples.as_ptr() == pointer, owned);
+            assert_eq!(numbers.as_ptr() == values_pointer, owned);
+            assert_eq!(numbers.as_slice(), &[1.0, 2.0]);
+            if owned {
+                assert_eq!(samples.capacity(), capacity);
+                assert_eq!(numbers.capacity(), values_capacity);
+            } else {
+                let original = field.unwrap();
+                assert_eq!(original.try_as_time_samples_ref().unwrap(), &samples);
+            }
+        }
+        Ok(())
+    }
+
