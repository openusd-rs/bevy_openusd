#usda 1.0
(
    defaultPrim = "PI"
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 10
)
def Scope "Library" {
    token visibility = "invisible"
    def Xform "Assembly" {
        def Cube "Cube" {
            double size.timeSamples = {0: 0.4, 10: 0.8}
            color3f[] primvars:displayColor = [(0.8,0.2,0.1)]
        }
        def Sphere "Sphere" {
            double radius.timeSamples = {0: 0.2, 10: 0.4}
            double3 xformOp:translate = (1,0,0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cylinder "Cylinder" {
            double radius.timeSamples = {0: 0.2, 10: 0.4}
            double height.timeSamples = {0: 0.4, 10: 0.8}
            uniform token axis = "Y"
            double3 xformOp:translate = (2,0,0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Capsule "Capsule" {
            double radius.timeSamples = {0: 0.15, 10: 0.3}
            double height.timeSamples = {0: 0.3, 10: 0.6}
            uniform token axis = "Y"
            double3 xformOp:translate = (3,0,0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Cone "Cone" {
            double radius.timeSamples = {0: 0.2, 10: 0.4}
            double height.timeSamples = {0: 0.4, 10: 0.8}
            uniform token axis = "Y"
            double3 xformOp:translate = (4,0,0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Plane "Plane" {
            double width.timeSamples = {0: 0.4, 10: 0.8}
            double length.timeSamples = {0: 0.4, 10: 0.8}
            uniform token axis = "Z"
            double3 xformOp:translate = (5,0,0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
def PointInstancer "PI" {
    rel prototypes = </Library/Assembly>
    int[] protoIndices = [0,0]
    point3f[] positions = [(0,0,0), (0,1.5,0)]
}
