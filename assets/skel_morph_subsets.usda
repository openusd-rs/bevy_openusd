#usda 1.0
(
    subLayers = [@skel_material_subsets.usda@]
)
over "Test"
{
    over "Bar"
    {
        uniform token[] skel:blendShapes = ["TipOffset"]
        rel skel:blendShapeTargets = </TipOffset>
    }
    over "Skel"
    {
        over "Anim"
        {
            uniform token[] blendShapes = ["TipOffset"]
            float[] blendShapeWeights.timeSamples = { 0: [0], 30: [1], 60: [0] }
        }
    }
}
def BlendShape "TipOffset"
{
    uniform int[] pointIndices = [12,13,14,15]
    uniform vector3f[] offsets = [(0.5,0,0.5), (0.5,0,0.5), (0.5,0,0.5), (0.5,0,0.5)]
}
