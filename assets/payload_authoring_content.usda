#usda 1.0
def Xform "Box" {
    def Cube "Shape" {
        double size = 2
        color3f[] primvars:displayColor = [(0.1,0.6,1)] ( interpolation = "constant" )
    }
}
def Xform "Ball" {
    def Sphere "Shape" {
        double radius = 1
        color3f[] primvars:displayColor = [(1,0.3,0.05)] ( interpolation = "constant" )
    }
}
