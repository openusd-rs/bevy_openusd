+        for value in [
+            Value::TimeSamples(Vec::new()),
+            Value::Float(1.0),
+            Value::None,
+            Value::ValueBlock,
+        ] {
+            let blocked = matches!(value, Value::None | Value::ValueBlock);
+            for field in [
+                SampleField::classify(Cow::Borrowed(&value)),
+                SampleField::classify(Cow::Owned(value.clone())),
+            ] {
+                assert_eq!(matches!(field, SampleField::Blocked), blocked);
+                assert_eq!(matches!(field, SampleField::Unusable), !blocked);
+            }
+        }
+    }
