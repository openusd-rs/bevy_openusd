+    #[test]
+    fn metadata_counts_capacity() -> Result<()> {
+        let (_, anim) = fixture()?;
+        let mut query = AnimQuery::new(anim)?;
+        query.joints = Vec::with_capacity(64);
+        let mut joint = String::with_capacity(1024);
+        joint.push_str("root");
+        query.joints.push(joint);
+        let mut shape = String::with_capacity(512);
+        shape.push_str("smile");
+        query.blend_shapes = vec![shape].into();
+        let expected = size_of::<AnimQuery>()
+            + query.anim.prim().path().heap_bytes().unwrap()
+            + 64 * size_of::<String>()
+            + 1024
+            + size_of::<String>()
+            + 512;
+        assert_eq!(query.metadata_bytes(), Some(expected));
+        assert!(query.clone().metadata_bytes().unwrap() < expected);
+        Ok(())
+    }
+
+    #[test]
+    fn metadata_excludes_sources() -> Result<()> {
+        let (_, anim) = fixture()?;
+        let direct = AnimQuery::new(anim.clone())?;
+        let budget = QueryCacheBudget::new(1024 * 1024, 8);
+        let query = AnimQuery::with_budget(anim, &budget)?;
+        let paths: usize = query
+            .queries
+            .as_ref()
+            .unwrap()
+            .iter()
+            .map(|q| q.attribute().path().heap_bytes().unwrap())
+            .sum();
+        let bytes = direct.metadata_bytes().unwrap() + size_of::<[AttributeQuery; 4]>() + paths;
+        assert_eq!(query.metadata_bytes(), Some(bytes));
+        query.joint_local_transforms(TimeCode::new(5.0))?;
+        assert!(budget.retained_bytes() > 0);
+        assert_eq!(query.metadata_bytes(), Some(bytes));
+        drop(query);
+        assert_eq!(budget.retained_bytes(), 0);
+        Ok(())
+    }
