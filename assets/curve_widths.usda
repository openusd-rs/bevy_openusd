#usda 1.0
(
    upAxis = "Y"
    metersPerUnit = 1
)

def Camera "Camera" {
    float focalLength = 50
    float horizontalAperture = 36
    float verticalAperture = 20.25
    double3 xformOp:translate = (0,2,10)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}

def BasisCurves "ConstantTube" {
    uniform token type = "linear"
    point3f[] points = [(-2,0.5,0),(2,0.5,0)]
    int[] curveVertexCounts = [2]
    float[] widths = [0.2] ( interpolation = "constant" )
}

def BasisCurves "VertexTube" {
    uniform token type = "linear"
    point3f[] points = [(-2,1.25,0),(2,1.25,0)]
    int[] curveVertexCounts = [2]
    float[] widths = [0.05,0.4] ( interpolation = "vertex" )
}

def BasisCurves "VaryingTube" {
    uniform token type = "cubic"
    uniform token basis = "bezier"
    point3f[] points = [(-2,2,0),(-1,2.5,0),(1,1.5,0),(2,2,0)]
    int[] curveVertexCounts = [4]
    float[] widths = [0.4,0.05] ( interpolation = "varying" )
}

def BasisCurves "Ribbon" {
    uniform token type = "cubic"
    uniform token basis = "bezier"
    point3f[] points = [(-2,2.75,0),(-1,3.25,0),(1,2.25,0),(2,2.75,0)]
    int[] curveVertexCounts = [4]
    float[] widths = [0.2] ( interpolation = "constant" )
    normal3f[] normals = [(0,0,1)] ( interpolation = "constant" )
}

def BasisCurves "PrimvarWidth" {
    uniform token type = "linear"
    point3f[] points = [(-2,3.5,0),(2,3.5,0)]
    int[] curveVertexCounts = [2]
    float[] widths = [0.02] ( interpolation = "constant" )
    float[] primvars:widths = [0.3] ( interpolation = "constant" )
}
