+    fn compare(query: &AnimQuery, direct: &AnimQuery) -> Result<()> {
+        assert_eq!(query.joint_order(), direct.joint_order());
+        assert_eq!(query.blend_shape_order(), direct.blend_shape_order());
+        assert_eq!(
+            query.joint_transform_time_samples()?,
+            direct.joint_transform_time_samples()?
+        );
+        assert_eq!(
+            query.blend_shape_weight_time_samples()?,
+            direct.blend_shape_weight_time_samples()?
+        );
+        assert_eq!(
+            query.joint_transforms_might_be_time_varying()?,
+            direct.joint_transforms_might_be_time_varying()?
+        );
+        assert_eq!(
+            query.blend_shape_weights_might_be_time_varying()?,
+            direct.blend_shape_weights_might_be_time_varying()?
+        );
+        for time in [
+            None,
+            Some(-1.0),
+            Some(0.0),
+            Some(5.0),
+            Some(10.0),
+            Some(5.0),
+            Some(11.0),
+        ] {
+            let time = time.map(TimeCode::new);
+            assert_eq!(
+                query.joint_transform_components(time)?,
+                direct.joint_transform_components(time)?
+            );
+            assert_eq!(
+                query.joint_local_transforms(time)?,
+                direct.joint_local_transforms(time)?
+            );
+            assert_eq!(query.blend_shape_weights(time)?, direct.blend_shape_weights(time)?);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn budgeted_modes_bounds() -> Result<()> {
+        let (stage, anim) = fixture()?;
+        let direct = AnimQuery::new(anim.clone())?;
+        assert!(direct.queries.is_none());
+        for (bytes, entries) in [(16_384, 4), (16_384, 1), (0, 4), (1, 4), (16_384, 0)] {
+            let budget = QueryCacheBudget::new(bytes, entries);
+            let query = AnimQuery::with_budget(anim.clone(), &budget)?;
+            for mode in [InterpolationType::Linear, InterpolationType::Held] {
+                stage.set_interpolation(mode);
+                compare(&query, &direct)?;
+                assert!(budget.retained_bytes() <= bytes);
+                assert!(budget.retained_entries() <= entries);
+            }
+            assert_eq!(budget.retained_entries(), if bytes >= 16_384 { entries } else { 0 });
+            drop(query);
+            assert_eq!(budget.retained_bytes(), 0);
+            assert_eq!(budget.retained_entries(), 0);
+        }
+        Ok(())
+    }
+
+    #[test]
+    fn budgeted_clone_release() -> Result<()> {
+        let (_, anim) = fixture()?;
+        let direct = AnimQuery::new(anim.clone())?;
+        let budget = QueryCacheBudget::new(16_384, 4);
+        let first = AnimQuery::with_budget(anim, &budget)?;
+        compare(&first, &direct)?;
